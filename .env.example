# =========================================================================
# AUTOCOMPT - PRODUCTION ENVIRONMENT VARIABLES (BLUEPRINT)
# =========================================================================

# API Base URL for future backend integration
VITE_API_URL=https://api.autocompt.ca

# Google Drive Integration Variables
# Client ID for the OAuth 2.0 Web Application credentials configured in Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Target Google Drive shared folder ID where user documents and tax logs will sync
VITE_GOOGLE_DRIVE_FOLDER_ID=your-google-drive-shared-folder-id

# Local Developer / Live Sandbox Mode Toggle
VITE_ENABLE_SANDBOX=true
